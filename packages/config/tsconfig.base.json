{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "AIPVS Base",

  // This file deliberately declares no `rootDir`, `outDir`, `include` or
  // `exclude`. Path-valued options in a shared config resolve relative to THIS
  // file's directory, not the package that extends it, so declaring them here
  // silently points every consumer at `packages/config/`. Each package sets
  // its own.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Taskbook §136 — strict is mandatory, noUncheckedIndexedAccess recommended.
    // §0.1 rule 17 forbids hiding problems behind `any` or disabled checks.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true
  }
}
