# ===========================================================================
# AI Product Video Studio — environment template
# ===========================================================================
# Copy to `.env` and fill in. NEVER put real secrets in this file (taskbook §7).
# `.env` is gitignored. Only NEXT_PUBLIC_* values ever reach the browser (§7).
# ===========================================================================

# --- Application ----------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aipvs
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis (cache + Celery broker/result backend) -------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth (§39) -----------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# --- Object Storage, S3 compatible (§4.6, §11) ----------------------------
# Local dev defaults target the MinIO container from docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aipvs-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000/aipvs-dev
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# --- AI Providers (§20, §138) ---------------------------------------------
# Leave blank for local development — USE_MOCK_PROVIDERS=true needs no keys.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
RUNWAY_API_KEY=

TTS_PROVIDER=mock
TTS_API_KEY=

DEFAULT_VIDEO_PROVIDER=mock
DEFAULT_LLM_PROVIDER=mock
DEFAULT_VISION_PROVIDER=mock
DEFAULT_IMAGE_PROVIDER=mock

# --- Media toolchain (§4.7, §35) ------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_SECONDS=1800

# --- Observability (§63) --------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aipvs-api

# --- Upload limits (§12) --------------------------------------------------
MAX_UPLOAD_IMAGE_MB=20
MAX_UPLOAD_VIDEO_MB=500
MAX_PROJECT_DURATION_SECONDS=120
# Decompression-bomb ceiling: a small PNG can declare enormous dimensions, so
# the byte limit above does not bound decoded memory on its own.
MAX_UPLOAD_IMAGE_MEGAPIXELS=50
MAX_UPLOAD_IMAGE_DIMENSION=16384
MAX_UPLOAD_VIDEO_DURATION_SECONDS=900
# Wall-clock budget for ffprobe when inspecting an upload.
MEDIA_PROBE_TIMEOUT_SECONDS=30

# --- Worker concurrency (§25) ---------------------------------------------
VIDEO_GENERATION_CONCURRENCY=4
TTS_CONCURRENCY=4
RENDER_CONCURRENCY=2
QC_CONCURRENCY=2

# --- Job behaviour (§24, §161) --------------------------------------------
JOB_MAX_RETRIES=3
JOB_RETRY_BASE_DELAY_SECONDS=5
JOB_STUCK_THRESHOLD_SECONDS=3600

# --- Feature flags (§122, §170) -------------------------------------------
# USE_MOCK_PROVIDERS=true lets a developer run the full E2E flow with no API
# keys at all. Taskbook §170 marks this as a MUST, not a nicety.
USE_MOCK_PROVIDERS=true
ENABLE_REAL_VIDEO_PROVIDER=false
ENABLE_QC=false
ENABLE_CREDITS=false
ENABLE_MULTI_PROVIDER=false
ENABLE_BATCH=false

# --- Mock provider failure injection (§172) -------------------------------
# success | fail | timeout | slow
MOCK_VIDEO_MODE=success

# --- Web (browser-exposed; MUST stay non-secret) --------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
